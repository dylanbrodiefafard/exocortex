// Trimmer: head, tail and error blocks of long bash logs, and the start of an output pi cut,
// recovered from pi's saved copy (D-110). Acceptance: no drop in success and no rise in turns or
// wall-clock (research R2.4). Slice by the noisy-output tag.
{
	"modules": {
		"trimmer": { "enabled": true }
	}
}
