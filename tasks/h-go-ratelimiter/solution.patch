 )
 
 // Limiter is a token-bucket rate limiter.
 type Limiter struct {
-	mu    sync.Mutex
-	clock Clock
-	rate  float64 // tokens per second
-	burst int
+	mu     sync.Mutex
+	clock  Clock
+	rate   float64 // tokens per second
+	burst  int
+	tokens float64
+	last   time.Time
 }
 
 // New returns a Limiter that refills at rate tokens per second and holds at
 // most burst tokens. If clock is nil, RealClock is used.
 func New(rate float64, burst int, clock Clock) *Limiter {
+	if rate <= 0 {
+		panic("ratelimit: rate must be positive")
+	}
+	if burst < 1 {
+		panic("ratelimit: burst must be at least 1")
+	}
 	if clock == nil {
 		clock = RealClock{}
 	}
-	return &Limiter{clock: clock, rate: rate, burst: burst}
+	return &Limiter{clock: clock, rate: rate, burst: burst, tokens: float64(burst), last: clock.Now()}
+}
+
+// advance credits tokens accrued since the last update. l.mu must be held.
+func (l *Limiter) advance() {
+	now := l.clock.Now()
+	if elapsed := now.Sub(l.last); elapsed > 0 {
+		l.tokens += elapsed.Seconds() * l.rate
+		if max := float64(l.burst); l.tokens > max {
+			l.tokens = max
+		}
+	}
+	l.last = now
+}
+
+// take consumes a token if one is available. Otherwise it returns how long
+// until one will be. l.mu must be held.
+func (l *Limiter) take() (bool, time.Duration) {
+	l.advance()
+	if l.tokens >= 1 {
+		l.tokens--
+		return true, 0
+	}
+	need := (1 - l.tokens) / l.rate
+	d := time.Duration(need * float64(time.Second))
+	if float64(d) < need*float64(time.Second) {
+		d++
+	}
+	return false, d
 }
 
 // Allow reports whether a token is available now, consuming it if so.
 func (l *Limiter) Allow() bool {
-	return false
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	ok, _ := l.take()
+	return ok
 }
 
 // Wait blocks until a token is available and consumes it, or until ctx is done.
 func (l *Limiter) Wait(ctx context.Context) error {
-	return nil
+	for {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+		l.mu.Lock()
+		ok, d := l.take()
+		l.mu.Unlock()
+		if ok {
+			return nil
+		}
+		timer := l.clock.NewTimer(d)
+		select {
+		case <-timer.C():
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		}
+	}
 }
 
 // SetRate changes the refill rate.
 func (l *Limiter) SetRate(rate float64) {
+	if rate <= 0 {
+		panic("ratelimit: rate must be positive")
+	}
 	l.mu.Lock()
 	defer l.mu.Unlock()
+	l.advance()
 	l.rate = rate
 }
 
