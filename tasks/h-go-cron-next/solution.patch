+	if !isDigits(text) {
+		return 0, "bad value " + strconv.Quote(text)
+	}
+	v, err := strconv.Atoi(text)
+	if err != nil || v < f.min || v > f.max {
+		return 0, "value " + strconv.Quote(text) + " out of range"
+	}
+	return v, ""
