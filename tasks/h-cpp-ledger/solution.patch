+    std::vector<Account*> dsts;
+    for (const auto& id : to) dsts.push_back(&get(id));
+    if (to.empty()) throw std::invalid_argument("split needs at least one recipient");
+    std::set<std::string> seen(to.begin(), to.end());
+    if (seen.size() != to.size()) throw std::invalid_argument("duplicate recipient");
+    if (seen.count(from)) throw std::invalid_argument("payer cannot be a recipient");
