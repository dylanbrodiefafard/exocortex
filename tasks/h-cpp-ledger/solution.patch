+    for (const Entry& e : a.entries) {
+        std::string desc;
+        switch (e.kind) {
+            case Kind::Deposit: desc = "deposit"; break;
+            case Kind::Withdrawal: desc = "withdrawal"; break;
+            case Kind::TransferIn: desc = "transfer from " + e.counterparty; break;
+            case Kind::TransferOut: desc = "transfer to " + e.counterparty; break;
+            case Kind::Interest: desc = "interest"; break;
+        }
