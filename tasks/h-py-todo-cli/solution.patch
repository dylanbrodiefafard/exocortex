 import argparse
+import datetime
+import json
+import os
+import re
 import sys
 
 from todo import storage
 from todo.formatting import format_tasks
 
+DATE_RE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+
+def parse_date(value):
+    """Parse a strict YYYY-MM-DD date, or return None if invalid."""
+    if not DATE_RE.fullmatch(value):
+        return None
+    try:
+        return datetime.date.fromisoformat(value)
+    except ValueError:
+        return None
+
+
+def today():
+    override = os.environ.get("TODO_TODAY")
+    if override:
+        parsed = parse_date(override)
+        if parsed is None:
+            raise ValueError(f"invalid TODO_TODAY: {override!r}")
+        return parsed
+    return datetime.date.today()
+
 
