@@ -1,9 +1,10 @@
 """HTML filters."""
 
-from inkwell.filters.args import str_arg
+from inkwell.filters.args import int_arg, str_arg
 from inkwell.filters.registry import register_filter
 from inkwell.site.urls import absolute_url
 from inkwell.text.html import Markup, escape, strip_tags
+from inkwell.text.words import truncate_words
 
 
 @register_filter("escape")
@@ -24,6 +25,19 @@ def striptags(value):
     return strip_tags("" if value is None else value)
 
 
+MORE_MARKER = "<!--more-->"
+
+
+@register_filter("excerpt", args=(0, 1), needs_context=True)
+def excerpt(ctx, value, count=None):
+    """First N words of the text, without HTML."""
+    text = "" if value is None else str(value)
+    words = ctx.config.excerpt_words if count is None else int_arg("excerpt", count, minimum=1)
+    if MORE_MARKER in text:
+        return strip_tags(text.split(MORE_MARKER, 1)[0])
+    return truncate_words(strip_tags(text), words)
+
+
 @register_filter("absurl", needs_context=True)
 def absurl(ctx, value):
     """Absolute URL of a site path, using [site] base_url."""
