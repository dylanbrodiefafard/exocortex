+/// A byte range of the template source.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Span {
+    start: usize,
+    end: usize,
+}
+
+impl Span {
+    /// The text this span covers in `src`, which must be the source it was parsed from.
+    pub fn of(self, src: &str) -> &str {
+        &src[self.start..self.end]
+    }
+}
