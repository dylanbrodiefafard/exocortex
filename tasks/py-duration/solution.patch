--- a/durations.py
+++ b/durations.py
@@ -1,5 +1,11 @@
 """Parsing of human-written durations."""
 
+import re
+
+_PART = re.compile(r"(\d+)([dhms])\s*")
+_SECONDS = {"d": 86400, "h": 3600, "m": 60, "s": 1}
+_ORDER = "dhms"
+
 
 def parse_duration(text):
     """Parse a duration such as "1h30m", "45s" or "2d 4h" into whole seconds.
@@ -12,4 +18,20 @@ def parse_duration(text):
     - Anything else (empty input, unknown units, missing numbers, repeated or out-of-order
       units, signs, decimals) raises ValueError.
     """
-    raise NotImplementedError
+    remaining = text.strip().lower()
+    if not remaining:
+        raise ValueError("empty duration")
+    total = 0
+    last = -1
+    while remaining:
+        match = _PART.match(remaining)
+        if not match:
+            raise ValueError(f"invalid duration: {text!r}")
+        number, unit = match.groups()
+        index = _ORDER.index(unit)
+        if index <= last:
+            raise ValueError(f"repeated or out-of-order unit in {text!r}")
+        last = index
+        total += int(number) * _SECONDS[unit]
+        remaining = remaining[match.end():]
+    return total
