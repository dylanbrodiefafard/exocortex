+pub struct Forth {
+    stack: Vec<Value>,
+    /// Every definition ever made. Bodies refer to earlier entries by index,
+    /// so redefining a name never changes existing bodies.
+    defs: Vec<Vec<Op>>,
+    /// Current meaning of each user-defined name (lowercase) as an index into `defs`.
+    names: HashMap<String, usize>,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum Builtin {
+    Add,
+    Sub,
+    Mul,
+    Div,
+    Dup,
+    Drop,
+    Swap,
+    Over,
+}
+
+#[derive(Debug, Clone, Copy)]
+enum Op {
+    Push(Value),
+    Builtin(Builtin),
+    Call(usize),
+}
+
+fn builtin(name: &str) -> Option<Builtin> {
+    Some(match name {
+        "+" => Builtin::Add,
+        "-" => Builtin::Sub,
+        "*" => Builtin::Mul,
+        "/" => Builtin::Div,
+        "dup" => Builtin::Dup,
+        "drop" => Builtin::Drop,
+        "swap" => Builtin::Swap,
+        "over" => Builtin::Over,
+        _ => return None,
+    })
+}
+
+fn parse_number(token: &str) -> Option<Value> {
+    let digits = token.strip_prefix('-').unwrap_or(token);
+    if digits.is_empty() || !digits.bytes().all(|b| b.is_ascii_digit()) {
+        return None;
+    }
+    // Wrap like the arithmetic does rather than failing on huge literals.
+    let mut value: Value = 0;
+    for b in digits.bytes() {
+        value = value.wrapping_mul(10).wrapping_add(Value::from(b - b'0'));
+    }
+    Some(if token.starts_with('-') { value.wrapping_neg() } else { value })
+}
 
