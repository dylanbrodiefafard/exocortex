 // Deliver sends d upstream. Each attempt is bounded by upstream.timeout_ms.
-// It returns an error wrapping ErrUpstream or ErrRejected on failure.
+// Upstream failures (transport errors, 5xx) are retried up to
+// retry.max_attempts attempts in total, waiting retry.backoff_ms before the
+// second attempt and doubling the wait each time. It returns an error wrapping
+// ErrUpstream or ErrRejected on failure, or the context's error if ctx ends
+// between attempts.
 func (c *Client) Deliver(ctx context.Context, d Delivery) (Result, error) {
 	start := c.clock.Now()
 	res := Result{ID: d.ID}
-	status, err := c.attempt(ctx, d)
-	res.Attempts = 1
-	res.Status = status
+	maxAttempts := c.retry.MaxAttempts
+	if maxAttempts < 1 {
+		maxAttempts = 1
+	}
+	var err error
+	for n := 1; ; n++ {
+		status, sendErr := c.attempt(ctx, d)
+		res.Attempts = n
+		res.Status = status
+		err = classify(status, sendErr)
+		if err == nil || !errors.Is(err, ErrUpstream) || n >= maxAttempts {
+			break
+		}
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			err = ctxErr
+			break
+		}
+		c.clock.Sleep(time.Duration(c.retry.BackoffMS) * time.Millisecond << (n - 1))
+		if ctxErr := ctx.Err(); ctxErr != nil {
+			err = ctxErr
+			break
+		}
+	}
 	res.Duration = c.clock.Now().Sub(start)
-	return res, classify(status, err)
+	return res, err
 }
 
