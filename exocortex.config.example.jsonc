// Exocortex configuration (JSONC). Copy to ~/.exocortex/config.jsonc. EXO_CONFIG=<path> replaces
// that file. A project's own <repo>/.exocortex/config.jsonc may switch modules on or off and tune
// them; what says where things go or what is run counts only in your own file (D-087).
//
// Set only what you want different: everything left out takes its default, so a better default
// reaches you when Exocortex updates (D-106). Each module's settings and defaults are documented in
// packages/mod-<module>/src/settings.ts. A setting that no longer exists is ignored with a notice;
// a misspelled one or an invalid value switches Exocortex off with a warning, so a typo cannot
// change behaviour silently.
{
	// Where sidecar calls go. Left out, they go to pi's main model when it is an openai-completions
	// provider (same endpoint, model and key).
	"engine": {
		// "baseUrl": "http://127.0.0.1:8080/v1",
		// "model": "qwen3.8-27b",
		// "apiKey": "$NINFER_KEY",
		// What the engine supports (docs/INFERENCE_ENGINES.md): generic | vllm | sglang | llamacpp |
		// dylanbrodiefafard/ninfer (the fork; upstream ninfer is "generic" with "cachedTokens": true).
		"profile": "dylanbrodiefafard/ninfer"
	},

	"pool": {
		"maxConcurrent": 6, // MUST equal the engine's parallel slots (e.g. ninfer --max-concurrency); see D-038
		"reservedForMain": 2 // slots sidecar calls never take
	},

	// Optional: an OpenAI-compatible /embeddings server, e.g. a small model on the CPU (D-062). Memory
	// then recognises the same error in other words; without it, keywords decide.
	// "embeddings": { "baseUrl": "http://localhost:8081/v1", "model": "your-embedding-model" },

	// Modules are off unless enabled here. Toggle live in pi with /exo on|off and /exo <module> on|off.
	"modules": {
		"supervisor": {
			"enabled": false,
			"mode": "suggest", // "suggest": the follow-up goes in your editor; "auto": it is sent for you
			"checks": [] // commands run as evidence when the agent stops, e.g. ["npm test"]; your file only
		},
		"tools": {
			"enabled": false,
			// Checks run after an edit, tried before the built-in syntax checks; your file only.
			"checks": [] // e.g. [{ "files": "*.rs", "command": "cargo check --quiet --message-format short" }]
		},
		"triage": { "enabled": false },
		"memory": { "enabled": false },
		"trimmer": { "enabled": false },
		"compaction": { "enabled": false }
	}
}
