// Exocortex configuration (JSONC). Copy to ~/.exocortex/config.jsonc; a project can override any
// key in <repo>/.exocortex/config.jsonc. EXO_CONFIG=<path> replaces the global file. Unknown keys
// or invalid values disable Exocortex entirely (fail closed) and pi shows a warning.
{
	// Master kill switch.
	"enabled": true,

	// Append-only SQLite trace of every session (brief §5.1). Needed by eval and, later, memory.
	"trace": {
		"enabled": true,
		"dbPath": "~/.exocortex/exocortex.db"
	},

	// Where sidecar calls go. Unset fields fall back to pi's main model when it is an
	// openai-completions provider (same endpoint, model id and API key).
	"engine": {
		// "baseUrl": "http://127.0.0.1:8080/v1",
		// "model": "qwen3.8-27b",
		// "apiKey": "$NINFER_KEY",
		// What the engine supports (docs/INFERENCE_ENGINES.md): generic | vllm | sglang | llamacpp | ninfer.
		"profile": "ninfer"
		// Per-feature overrides, e.g. after adding json_schema support to your engine:
		// "features": { "jsonSchema": true }
	},

	// The sidecar scheduler (brief §5.2).
	"pool": {
		"maxConcurrent": 6, // MUST equal the engine's parallel slots (e.g. ninfer --max-concurrency); see D-038
		"reservedForMain": 2, // slots sidecars never take
		"timeoutMs": 20000, // per call, queueing included; a timeout degrades to "no help"
		"sessionTokenBudget": 0, // sidecar tokens per session; 0 = unlimited
		"backgroundWhenIdleOnly": true // background work waits for the main agent to go idle
	},

	// Modules are off unless enabled here. Every module also takes "maxCallsPerTurn" (default 4)
	// and "maxTokensPerCall" (default 1024). Toggle live in pi with /exo on|off and /exo <module> on|off.
	"modules": {
		"supervisor": {
			"enabled": false,
			"mode": "suggest", // "suggest": put the follow-up in your editor; "auto": send it itself
			"maxContinuations": 3, // follow-ups per task before it stays quiet
			"checks": [], // commands to run as evidence when the agent stops, e.g. ["npm test"]
			"runPromptChecks": true, // also run commands quoted verbatim in your request
			"checkTimeoutMs": 120000,
			"thinking": false, // sidecar reasoning for the ledger/verdict calls
			// Research options (docs/RESEARCH.md §1), off until A/B'd: see packages/eval/configs/supervisor-*.jsonc
			"preVerdict": false, // a failing check = incomplete with no LLM call
			"warningSignals": false, // flag skipped/deleted tests, stubs, unsupported "tests pass" claims
			"verdictStyle": "holistic", // or "per-criterion": each item judged with a quoted evidence line
			"finalMessage": "tail", // or "claims": show only the agent's success claims, marked unverified
			"completeVotes": 1 // >1: re-ask on "complete"; any dissent = uncertain
		},
		"trimmer": {
			"enabled": false,
			"tools": ["bash"], // tools whose results may be trimmed (read/edit/write never are)
			"minChars": 8000, // shorter results are left alone (~4 chars per token)
			"headLines": 40,
			"tailLines": 80,
			"contextLines": 3, // kept around each error line
			"sidecar": false, // let a sidecar pick the lines to keep (verbatim) for still-long outputs
			"sidecarTimeoutMs": 6000 // it holds the agent loop; on timeout the deterministic result is used
		},
		"triage": {
			"enabled": false,
			"sidecar": true, // a two-sentence hint when the same failure repeats (never on the first)
			"loopThreshold": 3, // repeats before the stronger "this approach is not working" warning
			"hintTimeoutMs": 8000,
			"hypotheses": 0, // at the loop threshold, this many parallel sidecars propose causes from different angles
			"benignCommands": ["grep", "egrep", "fgrep", "rg", "ag", "diff", "cmp", "test", "[", "which", "pgrep", "git diff"] // exit 1 = an answer
		},
		"memory": {
			"enabled": false,
			// "dbPath": "~/.exocortex/memory.db", // cards from every repo, scoped by repo (git remote)
			"learn": true, // learn from fixes: a command fails, files change, the same command passes
			"inject": true, // add a matching lesson to a failing tool result
			"distill": true, // a background sidecar phrases each lesson (else a summary of the edit)
			"maxCards": 2,
			"maxInjectChars": 1600 // ~400 tokens
		},
		"compaction": {
			"enabled": false,
			"fallback": "harness", // without a sidecar summary: "harness" (pi's own) or "deterministic"
			"timeoutMs": 90000,
			"maxConversationChars": 60000 // newest part of the compacted span sent to the sidecar
		}
	}
}
