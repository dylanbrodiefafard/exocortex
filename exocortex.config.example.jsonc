// Exocortex configuration (JSONC). Copy to ~/.exocortex/config.jsonc. EXO_CONFIG=<path> replaces
// that file. A project's own <repo>/.exocortex/config.jsonc may switch Exocortex and modules on or
// off and tune them. "trace", "engine", "pool", "embeddings", the supervisor's "checks", memory's
// "dbPath" and the trimmer's "saveDir" count only in your own file: set in a project's file they
// are left out and pi tells you which (D-087). Unknown keys, modules or module settings, and
// invalid values, disable Exocortex entirely (fail closed) and pi shows a warning.
{
	// Master kill switch.
	"enabled": true,

	// Append-only SQLite trace of every session (brief §5.1). Needed by eval and, later, memory.
	"trace": {
		"enabled": true,
		"dbPath": "~/.exocortex/exocortex.db", // a relative path is relative to this file's directory
		"retentionDays": 0 // delete sessions older than this many days when pi starts; 0 = keep everything
	},

	// Where sidecar calls go. Unset fields fall back to pi's main model when it is an
	// openai-completions provider (same endpoint, model id and API key).
	"engine": {
		// "baseUrl": "http://127.0.0.1:8080/v1",
		// "model": "qwen3.8-27b",
		// "apiKey": "$NINFER_KEY",
		// What the engine supports (docs/INFERENCE_ENGINES.md): generic | vllm | sglang | llamacpp | ninfer.
		"profile": "ninfer"
		// Per-feature overrides, e.g. after adding json_schema support to your engine:
		// "features": { "jsonSchema": true }
	},

	// The sidecar scheduler (brief §5.2).
	"pool": {
		"maxConcurrent": 6, // MUST equal the engine's parallel slots (e.g. ninfer --max-concurrency); see D-038
		"reservedForMain": 2, // slots sidecars never take
		"timeoutMs": 20000, // per call, queueing included; a timeout degrades to "no help"
		"sessionTokenBudget": 0, // sidecar tokens per session; 0 = unlimited
		"backgroundWhenIdleOnly": true, // background work waits for the main agent to go idle
		"maxHoldMs": 600000 // a background call waiting for that gives up after this long; its timeoutMs does not run meanwhile
	},

	// Optional: an OpenAI-compatible /embeddings server, e.g. a small model on the CPU (D-062).
	// Memory uses it to recognise the same error or preference in other words; without it, keywords decide.
	"embeddings": {
		// "baseUrl": "http://localhost:8081/v1",
		// "model": "your-embedding-model",
		// "apiKey": "$EMBEDDINGS_API_KEY",
		"timeoutMs": 2000
	},

	// Modules are off unless enabled here. Every module also takes "maxCallsPerTurn" (default 4)
	// and "maxTokensPerCall" (default 4096). Toggle live in pi with /exo on|off and /exo <module> on|off.
	"modules": {
		"supervisor": {
			"enabled": false,
			"mode": "suggest", // "suggest": put the follow-up in your editor; "auto": send it itself
			"maxContinuations": 3, // follow-ups per task before it stays quiet
			"checks": [], // commands to run as evidence when the agent stops, e.g. ["npm test"]
			"runPromptChecks": true, // also run commands quoted verbatim in your request
			"checkTimeoutMs": 120000,
			"maxEvidenceChars": 40000, // what the verdict reads of the diff and command output (~4 chars per token)
			"thinking": false, // sidecar reasoning for the ledger/verdict calls
			// Research options (docs/RESEARCH.md §1), off until A/B'd: see packages/eval/configs/supervisor-*.jsonc
			"preVerdict": false, // a failing check = incomplete with no LLM call
			"warningSignals": false, // flag skipped/deleted tests, stubs, unsupported "tests pass" claims
			"verdictStyle": "holistic", // or "per-criterion": each item judged with a quoted evidence line
			"finalMessage": "message", // or "claims": show only the agent's success claims, marked unverified
			"completeVotes": 1, // >1: re-ask on "complete"; any dissent = uncertain
			"verifyUncertain": false // on "uncertain": ask the agent once to check what the evidence does not show
		},
		"trimmer": {
			"enabled": false,
			"tools": ["bash"], // tools whose results may be trimmed (read/edit/write never are)
			"minChars": 8000, // shorter results are left alone (~4 chars per token)
			"headLines": 40,
			"tailLines": 80,
			"contextLines": 3, // kept before each error line
			"maxBlockLines": 30, // an error's own block (snippet, traceback, notes) is kept up to this many lines
			"hideRoutine": true, // hide passing tests and compile progress before anything else
			// "verbatimCommands": [...], // commands whose output is never trimmed; default: cat, grep, git diff, …
			"sidecar": false, // let a sidecar pick the lines to keep (verbatim) for still-long outputs
			"sidecarTimeoutMs": 6000 // it holds the agent loop; on timeout the deterministic result is used
		},
		"triage": {
			"enabled": false,
			// A failure repeats when it reports the same errors again; fewer failing tests is a new failure (D-073).
			"sidecar": true, // a two-sentence hint when the same failure repeats (never on the first)
			"maxHintsPerSignature": 2, // sidecar hints per repeated failure; the second must differ from the first
			"loopThreshold": 3, // sightings before the stronger "this approach is not working" warning
			"maskedFailures": true, // `cargo test 2>&1 | tail` exits 0: count it as failed when its output has an error line
			"hintTimeoutMs": 6000, // at most 6000: the notice must be back within the time the host gives a rewrite
			"hypotheses": 0, // at the loop threshold, this many parallel sidecars propose causes from different angles
			"benignCommands": ["grep", "egrep", "fgrep", "rg", "ag", "diff", "cmp", "test", "[", "which", "pgrep", "git diff"] // exit 1 = an answer
		},
		"memory": {
			"enabled": false,
			// "dbPath": "~/.exocortex/memory.db", // cards from every repo, scoped by repo (git remote)
			"learn": true, // learn from fixes: a command fails, files change, the same command passes
			"inject": true, // add a matching lesson to a failing tool result
			"distill": true, // a background sidecar phrases each lesson (else a summary of the edit)
			"maxCards": 2,
			"minDetail": 0.6, // share of a card's names (tests, symbols, error codes) a failure must mention to count as the same problem
			"maxInjectChars": 1600, // ~400 tokens
			"preferences": false, // learn how you like work done and what you expect of a kind of task, from what you type and your corrections; add what a later prompt leaves unsaid (D-060, D-064)
			"maxPreferences": 5,
			"preferenceMinSessions": 2, // sessions an instruction must recur in, unless you said it as a standing rule
			"preferenceSelect": true, // a sidecar picks which preferences fit each prompt (else: all, minus keyword matches)
			"minSimilarity": 0.85, // with embeddings: how close an error must be to a card's to recall it
			"preferenceSimilarity": 0.8 // with embeddings: how close two preferences must be to count as one
		},
		"compaction": {
			"enabled": false,
			"fallback": "harness", // without a sidecar summary: "harness" (pi's own) or "deterministic"
			"timeoutMs": 90000,
			"maxConversationChars": 60000 // newest part of the compacted span sent to the sidecar
		}
	}
}
