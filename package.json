{
	"name": "exocortex",
	"private": true,
	"type": "module",
	"license": "GPL-3.0-or-later",
	"engines": {
		"node": ">=22.19.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "biome check --error-on-warnings .",
		"format": "biome check --write .",
		"knip": "knip",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "npm run lint && npm run typecheck && npm run knip && npm run test",
		"eval": "node packages/eval/src/cli.ts",
		"loadtest": "node packages/eval/src/loadtest-cli.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "22.20.5",
		"knip": "6.39.0",
		"typescript": "7.0.2",
		"vitest": "5.0.3"
	}
}
